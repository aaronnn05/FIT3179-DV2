{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Astronomy clubs hug the east coast",
    "subtitle": "Dot map: one dot = one club (42 of the 45 listed clubs have a known town)."
  },
  "width": 700,
  "height": 560,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27
    ],
    "scale": 840,
    "translate": [
      326,
      276
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#c3cbdf",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/astronomy_clubs.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 80,
        "opacity": 0.7,
        "fill": "#6a51a3",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Club",
            "type": "nominal"
          },
          {
            "field": "Town",
            "type": "nominal"
          },
          {
            "field": "State",
            "type": "nominal"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 124,
            "lat": -26,
            "text": "No clubs across\nthe whole centre"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 0,
        "fontSize": 15,
        "color": "#364152",
        "fontWeight": "normal",
        "lineBreak": "\n",
        "lineHeight": 16
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 136.7,
            "lat": -12.3,
            "lx": 129.5,
            "ly": -8.6,
            "text": "Gove: the only club\nin the Northern Territory",
            "align": "right",
            "dx": -8
          },
          {
            "lon": 151.2,
            "lat": -33.9,
            "lx": 158.0,
            "ly": -33.0,
            "text": "Sydney",
            "align": "left",
            "dx": 8
          },
          {
            "lon": 144.96,
            "lat": -37.8,
            "lx": 139.5,
            "ly": -41.5,
            "text": "Melbourne",
            "align": "right",
            "dx": -8
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#14213d",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lx"
        },
        "latitude2": {
          "field": "ly"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 136.7,
            "lat": -12.3,
            "lx": 129.5,
            "ly": -8.6,
            "text": "Gove: the only club\nin the Northern Territory",
            "align": "right",
            "dx": -8
          },
          {
            "lon": 151.2,
            "lat": -33.9,
            "lx": 158.0,
            "ly": -33.0,
            "text": "Sydney",
            "align": "left",
