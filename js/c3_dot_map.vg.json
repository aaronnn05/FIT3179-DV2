          },
          {
            "lon": 144.96,
            "lat": -37.8,
            "lx": 139.5,
            "ly": -41.5,
            "text": "Melbourne",
            "align": "right",
            "dx": -8
          }
        ]
      },
      "mark": {
        "type": "circle",
        "color": "#14213d",
        "size": 22
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.2,
            "lat": -33.9,
            "lx": 158.0,
            "ly": -33.0,
            "text": "Sydney",
            "align": "left",
            "dx": 8
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#14213d",
        "lineBreak": "\n",
        "lineHeight": 16,
        "dx": 8
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 136.7,
            "lat": -12.3,
            "lx": 129.5,
            "ly": -8.6,
            "text": "Gove: the only club\nin the Northern Territory",
            "align": "right",
            "dx": -8
          },
          {
            "lon": 144.96,
            "lat": -37.8,
            "lx": 139.5,
            "ly": -41.5,
            "text": "Melbourne",
            "align": "right",
            "dx": -8
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#14213d",
        "lineBreak": "\n",
        "lineHeight": 16,
        "dx": -8
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 30,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 17,
      "subtitleColor": "#364152",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#364152",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 15,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
