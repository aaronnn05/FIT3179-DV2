{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Aurora beats every other sky event, in every state",
    "subtitle": [
      "Share of each state's searches for four sky events, October 2021 to October 2026.",
      "The four shares for a state add up to 100%.",
      "Aurora map: every state labelled; others: top state only."
    ]
  },
  "repeat": [
    "Aurora",
    "Comet",
    "SolarEclipse",
    "LunarEclipse"
  ],
  "columns": 2,
  "spacing": {
    "row": 18,
    "column": 24
  },
  "spec": {
    "width": 340,
    "height": 310,
    "projection": {
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -133,
        0
      ],
      "center": [
        0,
        -27
      ],
      "scale": 428,
      "translate": [
        170,
        178
      ]
    },
    "layer": [
      {
        "data": {
          "url": "data/australia_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "mark": {
          "type": "geoshape",
          "fill": "#dde2ef",
          "stroke": "white",
          "strokeWidth": 1
        }
      },
      {
        "data": {
          "url": "data/event_searches_by_state.csv"
        },
        "transform": [
          {
            "lookup": "State",
            "from": {
              "data": {
                "url": "data/australia_states.topojson",
                "format": {
                  "type": "topojson",
                  "feature": "states"
                }
              },
              "key": "properties.name"
            },
            "as": "geo"
          }
        ],
        "mark": {
          "type": "geoshape",
          "stroke": "white",
          "strokeWidth": 0.8
        },
        "encoding": {
          "shape": {
            "field": "geo",
            "type": "geojson"
          },
          "color": {
            "field": {
              "repeat": "repeat"
            },
            "type": "quantitative",
            "title": "Share of the state's searches (%), in classes",
            "scale": {
              "type": "threshold",
              "domain": [
                5,
                10,
                15,
                20,
                30,
                60
              ],
              "range": [
                "#feedde",
                "#fdd0a2",
                "#fdae6b",
                "#fd8d3c",
                "#f16913",
                "#d94801",
                "#8c2d04"
              ]
            },
            "legend": null
          },
          "tooltip": [
            {
              "field": "State",
              "type": "nominal"
            },
            {
              "field": {
                "repeat": "repeat"
              },
              "type": "quantitative",
              "title": "Share of this state's searches (%)"
            }
          ]
        }
      },
      {
        "data": {
          "values": [
            {
              "lon": 122,
              "lat": -26,
              "Aurora": "47%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            },
            {
              "lon": 133.5,
              "lat": -20,
              "Aurora": "55%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            },
            {
              "lon": 144.5,
              "lat": -22.5,
              "Aurora": "50%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            },
            {
              "lon": 135.5,
              "lat": -30,
              "Aurora": "61%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            },
            {
              "lon": 146.5,
              "lat": -32.3,
              "Aurora": "59%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            },
            {
              "lon": 144,
              "lat": -36.9,
              "Aurora": "66%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "middle",
          "fontSize": 13,
          "fontWeight": "bold",
          "color": "#ffffff"
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "lon": 122,
              "lat": -26,
              "Aurora": "",
              "Comet": "25%",
              "SolarEclipse": "20%",
              "LunarEclipse": ""
            },
            {
              "lon": 144.5,
              "lat": -22.5,
              "Aurora": "",
              "Comet": "25%",
              "SolarEclipse": "",
              "LunarEclipse": "12%"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "middle",
          "fontSize": 13,
          "fontWeight": "bold",
          "color": "#14213d"
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "lon": 149.6,
              "lat": -42.6,
              "Aurora": "91%",
              "Comet": "",
              "SolarEclipse": "",
              "LunarEclipse": ""
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "fontSize": 13,
          "fontWeight": "bold",
          "color": "#14213d"
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "Aurora": "Aurora",
              "Comet": "Comet",
              "SolarEclipse": "Solar eclipse",
              "LunarEclipse": "Lunar eclipse"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "x": 0,
          "y": 0,
          "font": "'Source Serif 4', Georgia, serif",
          "fontSize": 17,
          "fontWeight": 600,
          "color": "#14213d"
        },
        "encoding": {
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 17,
      "subtitleColor": "#364152",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#364152",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 15,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
