{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Aurora dominates everywhere, but Tasmania searches for little else",
    "subtitle": [
      "Share of each state's searches among four sky events (aurora, comet, solar eclipse, lunar eclipse),",
      "Google Trends, October 2021 to October 2026. The four panels in each state add to 100%."
    ]
  },
  "repeat": [
    "SolarEclipse",
    "Aurora",
    "Comet",
    "LunarEclipse"
  ],
  "columns": 2,
  "spec": {
    "width": 300,
    "height": 250,
    "projection": {
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -133,
        0
      ],
      "center": [
        0,
        -27
      ],
      "scale": 400,
      "translate": [
        150,
        115
      ]
    },
    "layer": [
      {
        "data": {
          "url": "data/australia_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "mark": {
          "type": "geoshape",
          "fill": "#f1f3f7",
          "stroke": "white",
          "strokeWidth": 0.8
        }
      },
      {
        "data": {
          "url": "data/event_searches_by_state.csv"
        },
        "transform": [
          {
            "lookup": "State",
            "from": {
              "data": {
                "url": "data/australia_states.topojson",
                "format": {
                  "type": "topojson",
                  "feature": "states"
                }
              },
              "key": "properties.name"
            },
            "as": "geo"
          }
        ],
        "mark": {
          "type": "geoshape",
          "stroke": "white",
          "strokeWidth": 0.6
        },
        "encoding": {
          "shape": {
            "field": "geo",
            "type": "geojson"
          },
          "color": {
            "field": {
              "repeat": "repeat"
            },
            "type": "quantitative",
            "title": "Share of searches (%)",
            "scale": {
              "scheme": "blues",
              "type": "sqrt",
              "domain": [
                0,
                100
              ]
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 220,
              "values": [
                0,
                10,
                25,
                50,
                100
              ]
            }
          },
          "tooltip": [
            {
              "field": "State",
              "type": "nominal"
            },
            {
              "field": {
                "repeat": "repeat"
              },
              "type": "quantitative",
              "title": "Share of this state's searches (%)"
            }
          ]
        }
      },
      {
        "data": {
          "values": [
            {
              "SolarEclipse": "Solar eclipse\nHighest: Western Australia, 20%",
              "Aurora": "Aurora\nHighest: Tasmania, 91%",
              "Comet": "Comet\nHighest: Queensland and\nWestern Australia, 25%",
              "LunarEclipse": "Lunar eclipse\nHighest: Queensland, 12%"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "bottom",
          "x": 0,
          "y": "height",
          "fontSize": 12,
          "fontWeight": "bold",
          "color": "#10213f",
          "lineBreak": "\n",
          "lineHeight": 14
        },
        "encoding": {
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "font": "Space Grotesk, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#10213f",
      "subtitleFontSize": 13,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "offset": 10,
      "font": "Space Grotesk, Helvetica, Arial, sans-serif",
      "subtitleFont": "Space Grotesk, Helvetica, Arial, sans-serif"
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#334155",
      "titleColor": "#334155",
      "domainColor": "#9aa5b8",
      "tickColor": "#9aa5b8",
      "gridColor": "#e6e9ef"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#334155",
      "titleColor": "#334155"
    },
    "text": {
      "font": "Space Grotesk, Helvetica, Arial, sans-serif"
    }
  }
}
