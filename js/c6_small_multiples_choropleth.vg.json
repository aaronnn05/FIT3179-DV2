{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Aurora beats every other sky event, in every state",
    "subtitle": [
      "Share of each state's searches for four sky events, October 2021 to October 2026.",
      "The four maps for a state add up to 100%."
    ]
  },
  "repeat": [
    "Aurora",
    "Comet",
    "SolarEclipse",
    "LunarEclipse"
  ],
  "columns": 2,
  "spacing": {
    "row": 18,
    "column": 24
  },
  "spec": {
    "width": 340,
    "height": 310,
    "projection": {
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -133,
        0
      ],
      "center": [
        0,
        -27
      ],
      "scale": 428,
      "translate": [
        170,
        178
      ]
    },
    "layer": [
      {
        "data": {
          "url": "data/australia_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "mark": {
          "type": "geoshape",
          "fill": "#dde2ef",
          "stroke": "white",
          "strokeWidth": 1
        }
      },
      {
        "data": {
          "url": "data/event_searches_by_state.csv"
        },
        "transform": [
          {
            "lookup": "State",
            "from": {
              "data": {
                "url": "data/australia_states.topojson",
                "format": {
                  "type": "topojson",
                  "feature": "states"
                }
              },
              "key": "properties.name"
            },
            "as": "geo"
          }
        ],
        "mark": {
          "type": "geoshape",
          "stroke": "white",
          "strokeWidth": 0.8
        },
        "encoding": {
          "shape": {
            "field": "geo",
            "type": "geojson"
          },
          "color": {
            "field": {
              "repeat": "repeat"
            },
            "type": "quantitative",
            "title": "Share of searches (%)",
            "scale": {
              "scheme": {
                "name": "oranges",
                "extent": [
                  0.08,
                  1
                ]
              },
              "type": "sqrt",
              "domain": [
                0,
                100
              ]
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 240,
              "values": [
                0,
                10,
                25,
                50,
                100
              ]
            }
          },
          "tooltip": [
            {
              "field": "State",
              "type": "nominal"
            },
            {
              "field": {
                "repeat": "repeat"
              },
              "type": "quantitative",
              "title": "Share of this state's searches (%)"
            }
          ]
        }
      },
      {
        "data": {
          "values": [
            {
              "Aurora": "Aurora",
              "Comet": "Comet",
              "SolarEclipse": "Solar eclipse",
              "LunarEclipse": "Lunar eclipse"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "x": 0,
          "y": 0,
          "font": "'Source Serif 4', Georgia, serif",
          "fontSize": 17,
          "fontWeight": 600,
          "color": "#14213d"
        },
        "encoding": {
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "Aurora": "Top: Tasmania, 91%",
              "Comet": "Top: Queensland and Western Australia, 25%",
              "SolarEclipse": "Top: Western Australia, 20%",
              "LunarEclipse": "Top: Queensland, 12%"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "x": 0,
          "y": 26,
          "fontSize": 14,
          "color": "#4a5568"
        },
        "encoding": {
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 14,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
