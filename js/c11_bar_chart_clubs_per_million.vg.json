{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Clubs per million people, ranked",
    "subtitle": "Number of clubs in brackets."
  },
  "width": 440,
  "height": 250,
  "data": {
    "url": "data/astronomy_clubs.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Clubs"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/state_population.csv"
        },
        "key": "State",
        "fields": [
          "Population"
        ]
      }
    },
    {
      "calculate": "datum.Clubs / datum.Population * 1000000",
      "as": "ClubsPerMillion"
    },
    {
      "calculate": "format(datum.ClubsPerMillion, '.1f') + '  (' + datum.Clubs + ')'",
      "as": "Label"
    }
  ],
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {
        "op": "max",
        "field": "ClubsPerMillion",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 230,
        "ticks": false,
        "domain": false,
        "labelPadding": 8,
        "labelFontSize": 14,
        "labelColor": "#14213d"
      }
    },
    "x": {
      "field": "ClubsPerMillion",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          4.4
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#6a51a3",
        "size": 20,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Clubs",
            "type": "quantitative",
            "title": "Clubs"
          },
          {
            "field": "ClubsPerMillion",
            "type": "quantitative",
            "format": ".1f",
            "title": "Clubs per million people"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6
      },
      "encoding": {
        "text": {
          "field": "Label"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
