{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Per person, the Australian Capital Territory reports most",
    "subtitle": "Sky reports per million people, 2017 to 2025. Every state is an equal square."
  },
  "width": 600,
  "height": 420,
  "data": {
    "url": "data/globe_at_night_australia.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Reports"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/state_population.csv"
        },
        "key": "State",
        "fields": [
          "Population"
        ]
      }
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/state_tiles.csv"
        },
        "key": "State",
        "fields": [
          "Column",
          "Row",
          "Label"
        ]
      }
    },
    {
      "calculate": "toNumber(datum.Column)",
      "as": "Col"
    },
    {
      "calculate": "toNumber(datum.Row)",
      "as": "Rw"
    },
    {
      "calculate": "datum.Reports / datum.Population * 1000000",
      "as": "ReportsPerMillion"
    },
    {
      "calculate": "split(datum.Label + ';' + format(datum.ReportsPerMillion, ',.0f'), ';')",
      "as": "TileText"
    }
  ],
  "encoding": {
    "x": {
      "field": "Col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.06,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": "Rw",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.06,
        "paddingOuter": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "ReportsPerMillion",
          "type": "quantitative",
          "title": "Reports per million people",
          "scale": {
            "scheme": {
              "name": "teals",
              "extent": [
                0.1,
                1
              ]
            },
            "domain": [
              0,
              600
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "values": [
              0,
              200,
              400,
              600
            ]
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Reports",
            "type": "quantitative",
            "title": "Reports",
            "format": ","
          },
          {
            "field": "Population",
            "type": "quantitative",
            "format": ",",
            "title": "People"
          },
          {
            "field": "ReportsPerMillion",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Reports per million people"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "length(datum.TileText) == 2"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 13,
        "lineHeight": 16,
        "dy": -8
      },
      "encoding": {
        "text": {
          "field": "TileText"
        },
        "color": {
          "condition": {
            "test": "datum.ReportsPerMillion > 300",
            "value": "white"
          },
          "value": "#14213d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "length(datum.TileText) == 3"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 13,
        "lineHeight": 16,
        "dy": -16
      },
      "encoding": {
        "text": {
          "field": "TileText"
        },
        "color": {
          "condition": {
            "test": "datum.ReportsPerMillion > 300",
            "value": "white"
          },
          "value": "#14213d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "length(datum.TileText) == 4"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 13,
        "lineHeight": 16,
        "dy": -24
      },
      "encoding": {
        "text": {
          "field": "TileText"
        },
        "color": {
          "condition": {
            "test": "datum.ReportsPerMillion > 300",
            "value": "white"
          },
          "value": "#14213d"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
