{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Searches for \"stargazing\" almost tripled",
    "subtitle": "Average monthly Google searches in Australia (100 = busiest month)."
  },
  "width": 690,
  "height": 420,
  "data": {
    "url": "data/stargazing_searches_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Month": "date"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "Stargazing",
        "Astrophotography",
        "StarMap",
        "NightSky"
      ],
      "as": [
        "Term",
        "Interest"
      ]
    },
    {
      "calculate": "year(datum.Month)",
      "as": "Year"
    },
    {
      "filter": "datum.Year == 2016 || datum.Year == 2025"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "Interest",
          "as": "AverageInterest"
        }
      ],
      "groupby": [
        "Term",
        "Year"
      ]
    },
    {
      "calculate": "datum.Term == 'StarMap' ? 'Star map' : (datum.Term == 'NightSky' ? 'Night sky' : datum.Term)",
      "as": "TermName"
    },
    {
      "calculate": "datum.Year == 2025 ? (datum.Term == 'Stargazing' ? datum.AverageInterest + 1.6 : (datum.Term == 'StarMap' ? datum.AverageInterest - 1.6 : datum.AverageInterest)) : (datum.Term == 'Astrophotography' ? datum.AverageInterest + 2.6 : (datum.Term == 'Stargazing' ? datum.AverageInterest - 2.6 : datum.AverageInterest))",
      "as": "LabelY"
    },
    {
      "calculate": "datum.TermName",
      "as": "LabelRight"
    },
    {
      "calculate": "datum.TermName",
      "as": "LabelLeft"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelFontSize": 15,
        "labelColor": "#14213d",
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelPadding": 10
      },
      "scale": {
        "padding": 0.6
      }
    },
    "y": {
      "field": "AverageInterest",
      "type": "quantitative",
      "title": "Average searches (100 = busiest month)",
      "axis": {
        "values": [
          0,
          10,
          20,
          30,
          40
        ],
        "grid": true,
        "gridColor": {
          "condition": {
            "test": "datum.value == 0",
            "value": "#8f9ab3"
          },
          "value": "#cfd6e6"
        },
        "gridWidth": 1,
        "domain": false,
        "ticks": false
      },
      "scale": {
        "domain": [
          0,
          45
        ]
      }
    },
    "color": {
      "field": "TermName",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Stargazing",
          "Astrophotography",
          "Star map",
          "Night sky"
        ],
        "range": [
          "#c2410c",
          "#9aa3b2",
          "#9aa3b2",
          "#9aa3b2"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "TermName"
        },
        "tooltip": [
          {
            "field": "TermName",
            "title": "Search term"
          },
          {
            "field": "Year",
            "type": "ordinal"
          },
          {
            "field": "AverageInterest",
            "type": "quantitative",
            "format": ".1f",
            "title": "Average searches"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "TermName",
            "title": "Search term"
          },
          {
            "field": "Year",
            "type": "ordinal"
          },
          {
            "field": "AverageInterest",
            "type": "quantitative",
            "format": ".1f",
            "title": "Average searches"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 15
      },
      "encoding": {
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        },
        "text": {
          "field": "LabelRight"
        },
        "color": {
          "condition": {
            "test": "datum.Term == 'Stargazing'",
            "value": "#c2410c"
          },
          "value": "#364152"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2016"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 15
      },
      "encoding": {
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        },
        "text": {
          "field": "LabelLeft"
        },
        "color": {
          "condition": {
            "test": "datum.Term == 'Stargazing'",
            "value": "#c2410c"
          },
          "value": "#364152"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 17,
      "subtitleColor": "#364152",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#364152",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 15,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
