{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "New South Wales has the most clubs",
    "subtitle": "Number of listed astronomy clubs in each state."
  },
  "width": 560,
  "height": 300,
  "data": {
    "url": "data/astronomy_clubs.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Clubs"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "calculate": "datum.State == 'New South Wales' || datum.State == 'Western Australia'",
      "as": "Key"
    },
    {
      "calculate": "datum.State == 'Western Australia' ? '2, in the largest state by area' : datum.Clubs + ' clubs'",
      "as": "Label"
    }
  ],
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {
        "op": "max",
        "field": "Clubs",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 230,
        "ticks": false,
        "domain": false,
        "labelPadding": 8,
        "labelFontSize": 14,
        "labelColor": "#14213d"
      }
    },
    "x": {
      "field": "Clubs",
      "type": "quantitative",
      "title": "Number of clubs",
      "axis": {
        "values": [
          0,
          5,
          10,
          15,
          20
        ],
        "grid": true,
        "domain": false,
        "ticks": false
      },
      "scale": {
        "domain": [
          0,
          22
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "Clubs"
        },
        "color": {
          "condition": {
            "test": "datum.Key",
            "value": "#6a51a3"
          },
          "value": "#c9bfe0"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 190,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Key",
            "value": "#6a51a3"
          },
          "value": "#c9bfe0"
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Clubs",
            "type": "quantitative",
            "title": "Clubs"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Key"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 15,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Label"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 14,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
