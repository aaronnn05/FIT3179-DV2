{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Big cities have the brightest skies",
    "subtitle": [
      "Typical sky darkness in each 2-degree square (about 200 km wide).",
      "Outlined squares are the darkest."
    ]
  },
  "width": 700,
  "height": 600,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27
    ],
    "scale": 810,
    "translate": [
      318,
      258
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6dcea",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/globe_at_night_australia.csv"
      },
      "transform": [
        {
          "bin": {
            "step": 2
          },
          "field": "Latitude",
          "as": [
            "lat0",
            "lat1"
          ]
        },
        {
          "bin": {
            "step": 2
          },
          "field": "Longitude",
          "as": [
            "lon0",
            "lon1"
          ]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Reports"
            },
            {
              "op": "median",
              "field": "SkyDarkness",
              "as": "MedianDarkness"
            }
          ],
          "groupby": [
            "lat0",
            "lat1",
            "lon0",
            "lon1"
          ]
        },
        {
          "filter": "datum.Reports < 5"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#bfc8de",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon0",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon1"
        },
        "latitude": {
          "field": "lat0",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "lat1"
        },
        "tooltip": [
          {
            "field": "Reports",
            "type": "quantitative",
            "title": "Reports in this square (fewer than 5)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/globe_at_night_australia.csv"
      },
      "transform": [
        {
          "bin": {
            "step": 2
          },
          "field": "Latitude",
          "as": [
            "lat0",
            "lat1"
          ]
        },
        {
          "bin": {
            "step": 2
          },
          "field": "Longitude",
          "as": [
            "lon0",
            "lon1"
          ]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Reports"
            },
            {
              "op": "median",
              "field": "SkyDarkness",
              "as": "MedianDarkness"
            }
          ],
          "groupby": [
            "lat0",
            "lat1",
            "lon0",
            "lon1"
          ]
        },
        {
          "filter": "datum.Reports >= 5"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon0",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon1"
        },
        "latitude": {
          "field": "lat0",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "lat1"
        },
        "color": {
          "field": "MedianDarkness",
          "type": "quantitative",
          "title": "Typical sky darkness (1 = bright, 7 = dark)",
          "scale": {
            "scheme": {
              "name": "blues",
              "extent": [
                0.18,
                1
              ]
            },
            "domain": [
              1,
              7
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 0,
            "legendY": 555,
            "gradientLength": 200,
            "titleLimit": 300,
            "values": [
              1,
              4,
              7
            ],
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "Reports",
            "type": "quantitative",
            "title": "Reports in this square"
          },
          {
            "field": "MedianDarkness",
            "type": "quantitative",
            "title": "Typical sky darkness (1 to 7)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/globe_at_night_australia.csv"
      },
      "transform": [
        {
          "bin": {
            "step": 2
          },
          "field": "Latitude",
          "as": [
            "lat0",
            "lat1"
          ]
        },
        {
          "bin": {
            "step": 2
