            "lon1"
          ]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Reports"
            },
            {
              "op": "median",
              "field": "SkyDarkness",
              "as": "MedianDarkness"
            }
          ],
          "groupby": [
            "lat0",
            "lat1",
            "lon0",
            "lon1"
          ]
        },
        {
          "filter": "datum.Reports >= 5 && datum.MedianDarkness >= 6"
        }
