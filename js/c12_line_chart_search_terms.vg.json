{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The jump in \"stargazing\" began in 2024 and has held",
    "subtitle": "Monthly Google searches in Australia, 2016 to 2026 (100 = busiest month)."
  },
  "width": 515,
  "height": 280,
  "data": {
    "url": "data/stargazing_searches_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Month": "date"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "Stargazing",
        "Astrophotography",
        "StarMap",
        "NightSky"
      ],
      "as": [
        "Term",
        "Interest"
      ]
    },
    {
      "calculate": "toNumber(datum.Interest)",
      "as": "Interest"
    },
    {
      "calculate": "datum.Term == 'StarMap' ? 'Star map' : (datum.Term == 'NightSky' ? 'Night sky' : datum.Term)",
      "as": "TermName"
    },
    {
      "calculate": "datum.Term == 'Stargazing' ? datum.Interest + 2.5 : (datum.Term == 'StarMap' ? datum.Interest - 2.5 : datum.Interest)",
      "as": "LabelY"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "field": "Month",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": "year",
            "grid": false
          }
        },
        "y": {
          "field": "Interest",
          "type": "quantitative",
          "title": "Searches (100 = busiest month)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "color": {
          "field": "TermName",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Stargazing",
              "Astrophotography",
              "Star map",
              "Night sky"
            ],
            "range": [
              "#c2410c",
              "#9aa3b2",
              "#9aa3b2",
              "#9aa3b2"
            ]
          }
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.Term == 'Stargazing'",
            "value": 2.6
          },
          "value": 1.4
        },
        "order": {
          "field": "Term",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "Month",
            "type": "temporal",
            "format": "%B %Y",
            "title": "Month"
          },
          {
            "field": "TermName",
            "title": "Search term"
          },
          {
            "field": "Interest",
            "type": "quantitative",
            "title": "Searches"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Month >= toDate('2026-10-01')"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 14
      },
      "encoding": {
        "x": {
          "field": "Month",
          "type": "temporal"
        },
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        },
        "text": {
          "field": "TermName"
        },
        "color": {
          "condition": {
            "test": "datum.Term == 'Stargazing'",
            "value": "#c2410c"
          },
          "value": "#4a5568"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 100,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
