{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "vconcat": [
    {
      "title": {
        "text": "Most sky reports come from the east coast",
        "subtitle": "Proportional symbol map: circle area shows the reports from each 3-degree square."
      },
      "width": 700,
      "height": 600,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -133,
          0
        ],
        "center": [
          0,
          -27
        ],
        "scale": 810,
        "translate": [
          318,
          258
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#cdd4e6",
            "stroke": "white",
            "strokeWidth": 1
          }
        },
        {
          "data": {
            "url": "data/globe_at_night_australia.csv"
          },
          "transform": [
            {
              "filter": {
                "param": "year_brush"
              }
            },
            {
              "bin": {
                "step": 3
              },
              "field": "Latitude",
              "as": [
                "lat0",
                "lat1"
              ]
            },
            {
              "bin": {
                "step": 3
              },
              "field": "Longitude",
              "as": [
                "lon0",
                "lon1"
              ]
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "Reports"
                }
              ],
              "groupby": [
                "lat0",
                "lat1",
                "lon0",
                "lon1"
              ]
            },
            {
              "calculate": "(datum.lat0 + datum.lat1) / 2",
              "as": "CentreLatitude"
            },
            {
              "calculate": "(datum.lon0 + datum.lon1) / 2",
              "as": "CentreLongitude"
            }
          ],
          "mark": {
            "type": "circle",
            "fill": "#1f6f7a",
            "opacity": 0.75,
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "CentreLongitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "CentreLatitude",
              "type": "quantitative"
            },
            "size": {
              "field": "Reports",
              "type": "quantitative",
              "title": "Reports",
              "scale": {
                "type": "linear",
                "domain": [
                  0,
                  1000
                ],
                "range": [
                  10,
                  2000
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 0,
                "legendY": 500,
                "direction": "horizontal",
                "values": [
                  10,
                  100,
                  500
                ],
                "symbolFillColor": "#b8c0cc",
                "symbolStrokeColor": "white"
              }
            },
            "order": {
              "field": "Reports",
              "type": "quantitative",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "Reports",
                "type": "quantitative",
                "title": "Reports from this area"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 151.2,
                "lat": -33.9,
                "lx": 156.5,
                "ly": -35.5,
                "text": "Sydney",
                "align": "left",
                "dx": 8
              },
              {
                "lon": 153.0,
                "lat": -27.5,
                "lx": 157.0,
                "ly": -24.5,
                "text": "Brisbane",
                "align": "left",
                "dx": 8
              },
              {
                "lon": 144.96,
                "lat": -37.8,
                "lx": 139.5,
                "ly": -41.2,
                "text": "Melbourne",
                "align": "right",
                "dx": -8
              },
              {
                "lon": 138.6,
                "lat": -34.9,
                "lx": 132.0,
                "ly": -38.6,
                "text": "Adelaide",
                "align": "right",
                "dx": -8
              },
              {
                "lon": 115.86,
                "lat": -31.95,
                "lx": 113.0,
                "ly": -37.2,
                "text": "Perth",
                "align": "left",
                "dx": 8
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#14213d",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lx"
            },
            "latitude2": {
              "field": "ly"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 151.2,
                "lat": -33.9,
                "lx": 156.5,
                "ly": -35.5,
                "text": "Sydney",
                "align": "left",
                "dx": 8
              },
              {
                "lon": 153.0,
                "lat": -27.5,
                "lx": 157.0,
                "ly": -24.5,
                "text": "Brisbane",
                "align": "left",
                "dx": 8
              },
              {
                "lon": 144.96,
                "lat": -37.8,
                "lx": 139.5,
                "ly": -41.2,
                "text": "Melbourne",
                "align": "right",
                "dx": -8
              },
              {
                "lon": 138.6,
                "lat": -34.9,
                "lx": 132.0,
                "ly": -38.6,
                "text": "Adelaide",
                "align": "right",
                "dx": -8
              },
              {
                "lon": 115.86,
                "lat": -31.95,
                "lx": 113.0,
                "ly": -37.2,
                "text": "Perth",
                "align": "left",
                "dx": 8
              }
            ]
          },
          "mark": {
            "type": "circle",
            "color": "#14213d",
            "size": 22
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 151.2,
                "lat": -33.9,
                "lx": 156.5,
                "ly": -35.5,
                "text": "Sydney",
                "align": "left",
                "dx": 8
              },
              {
                "lon": 153.0,
                "lat": -27.5,
                "lx": 157.0,
                "ly": -24.5,
                "text": "Brisbane",
                "align": "left",
                "dx": 8
              },
              {
                "lon": 115.86,
                "lat": -31.95,
                "lx": 113.0,
                "ly": -37.2,
                "text": "Perth",
                "align": "left",
                "dx": 8
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#14213d",
            "lineBreak": "\n",
            "lineHeight": 16,
            "dx": 8
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 144.96,
                "lat": -37.8,
                "lx": 139.5,
                "ly": -41.2,
                "text": "Melbourne",
                "align": "right",
                "dx": -8
              },
              {
                "lon": 138.6,
                "lat": -34.9,
                "lx": 132.0,
                "ly": -38.6,
                "text": "Adelaide",
                "align": "right",
                "dx": -8
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#14213d",
            "lineBreak": "\n",
            "lineHeight": 16,
            "dx": -8
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "One night in June 2020 brought in most reports",
        "subtitle": [
          "Reports each year. A national sky survey on 21 June 2020 explains the spike.",
          "Drag across the bars to filter the map above. Double-click to reset."
        ]
      },
      "width": 700,
      "height": 150,
      "layer": [
        {
          "data": {
            "url": "data/globe_at_night_australia.csv"
          },
          "params": [
            {
              "name": "year_brush",
              "select": {
                "type": "interval",
                "encodings": [
                  "x"
                ]
              }
            }
          ],
          "mark": {
            "type": "bar",
            "size": 34,
            "cornerRadiusEnd": 2
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  2016.4,
                  2025.6
                ],
                "nice": false
              },
              "axis": {
                "format": "d",
                "values": [
                  2017,
                  2018,
                  2019,
                  2020,
                  2021,
                  2022,
                  2023,
                  2024,
                  2025
                ],
                "grid": false,
                "ticks": false,
                "labelPadding": 6
              }
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative",
              "axis": null
            },
            "color": {
              "condition": {
                "test": "datum.Year == 2020",
                "value": "#1f6f7a"
              },
              "value": "#5fa8b0"
            },
            "tooltip": [
              {
                "field": "Year",
                "type": "quantitative",
                "format": "d"
              },
              {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Reports",
                "format": ","
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/globe_at_night_australia.csv"
          },
          "transform": [
            {
              "filter": "datum.Year != 2020"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -8,
            "fontSize": 13,
            "color": "#4a5568"
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative"
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative"
            },
            "text": {
              "aggregate": "count",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "Year": 2020,
                "y": 5200,
                "text": "2020: 5,622 reports,\n4,425 of them on 21 June"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 22,
            "fontSize": 14,
            "color": "#14213d",
            "fontWeight": "bold",
            "lineBreak": "\n",
            "lineHeight": 16
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    }
  ],
  "spacing": 24,
  "resolve": {
    "legend": {
      "color": "independent",
      "size": "independent"
    }
  },
  "padding": {
    "left": 0,
    "top": 2,
    "right": 34,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 14,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
