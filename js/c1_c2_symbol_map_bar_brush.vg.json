{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "vconcat": [
    {
      "title": {
        "text": "Most sky reports come from the east coast",
        "subtitle": "Bigger circle = more reports. Darker blue = darker sky."
      },
      "width": 620,
      "height": 530,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -133,
          0
        ],
        "center": [
          0,
          -27
        ],
        "scale": 740,
        "translate": [
          300,
          232
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e1e5ec",
            "stroke": "white",
            "strokeWidth": 1
          }
        },
        {
          "data": {
            "url": "data/globe_at_night_australia.csv"
          },
          "transform": [
            {
              "filter": {
                "param": "year_brush"
              }
            },
            {
              "bin": {
                "step": 3
              },
              "field": "Latitude",
              "as": [
                "lat0",
                "lat1"
              ]
            },
            {
              "bin": {
                "step": 3
              },
              "field": "Longitude",
              "as": [
                "lon0",
                "lon1"
              ]
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "Reports"
                },
                {
                  "op": "median",
                  "field": "SkyDarkness",
                  "as": "MedianDarkness"
                }
              ],
              "groupby": [
                "lat0",
                "lat1",
                "lon0",
                "lon1"
              ]
            },
            {
              "calculate": "(datum.lat0 + datum.lat1) / 2",
              "as": "CentreLatitude"
            },
            {
              "calculate": "(datum.lon0 + datum.lon1) / 2",
              "as": "CentreLongitude"
            }
          ],
          "mark": {
            "type": "circle",
            "opacity": 0.9,
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "CentreLongitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "CentreLatitude",
              "type": "quantitative"
            },
            "size": {
              "field": "Reports",
              "type": "quantitative",
              "title": "Reports",
              "scale": {
                "type": "linear",
                "domain": [
                  0,
                  1000
                ],
                "range": [
                  10,
                  2000
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 290,
                "legendY": 480,
                "direction": "horizontal",
                "values": [
                  10,
                  100,
                  500
                ],
                "symbolFillColor": "#b8c0cc",
                "symbolStrokeColor": "white"
              }
            },
            "color": {
              "field": "MedianDarkness",
              "type": "quantitative",
              "title": "Sky darkness (1 = bright, 7 = dark)",
              "scale": {
                "scheme": {
                  "name": "blues",
                  "extent": [
                    0.25,
                    1
                  ]
                },
                "domain": [
                  1,
                  7
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 0,
                "legendY": 480,
                "gradientLength": 200,
                "titleLimit": 300,
                "values": [
                  1,
                  4,
                  7
                ],
                "direction": "horizontal"
              }
            },
            "order": {
              "field": "Reports",
              "type": "quantitative",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "Reports",
                "type": "quantitative",
                "title": "Reports from this area"
              },
              {
                "field": "MedianDarkness",
                "type": "quantitative",
                "title": "Typical sky darkness (1 to 7)"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 151.2,
                "lat": -33.9,
                "text": "Sydney"
              },
              {
                "lon": 144.96,
                "lat": -37.8,
                "text": "Melbourne"
              },
              {
                "lon": 153.0,
                "lat": -27.5,
                "text": "Brisbane"
              },
              {
                "lon": 115.86,
                "lat": -31.95,
                "text": "Perth"
              },
              {
                "lon": 138.6,
                "lat": -34.9,
                "text": "Adelaide"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -10,
            "fontSize": 12,
            "color": "#14213d",
            "fontWeight": "bold",
            "lineBreak": "\n",
            "lineHeight": 16
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "One night in June 2020 brought in most reports",
        "subtitle": "Reports each year. Drag across the bars to filter the map above."
      },
      "width": 620,
      "height": 110,
      "layer": [
        {
          "data": {
            "url": "data/globe_at_night_australia.csv"
          },
          "params": [
            {
              "name": "year_brush",
              "select": {
                "type": "interval",
                "encodings": [
                  "x"
                ]
              }
            }
          ],
          "mark": {
            "type": "bar",
            "size": 30,
            "color": "#1f6f7a",
            "cornerRadiusEnd": 2
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  2016.4,
                  2025.6
                ],
                "nice": false
              },
              "axis": {
                "format": "d",
                "values": [
                  2017,
                  2018,
                  2019,
                  2020,
                  2021,
                  2022,
                  2023,
                  2024,
                  2025
                ],
                "grid": false,
                "ticks": false,
                "labelPadding": 6
              }
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative",
              "axis": null
            },
            "tooltip": [
              {
                "field": "Year",
                "type": "quantitative",
                "format": "d"
              },
              {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Reports",
                "format": ","
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/globe_at_night_australia.csv"
          },
          "mark": {
            "type": "text",
            "dy": -7,
            "fontSize": 13,
            "color": "#14213d"
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative"
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative"
            },
            "text": {
              "aggregate": "count",
              "type": "quantitative",
              "format": ","
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "Year": 2020,
                "y": 4300,
                "text": "21 June 2020 alone:\n4,425 reports"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 22,
            "fontSize": 13,
            "color": "#14213d",
            "fontWeight": "bold",
            "lineBreak": "\n",
            "lineHeight": 16
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    }
  ],
  "spacing": 24,
  "resolve": {
    "legend": {
      "color": "independent",
      "size": "independent"
    }
  },
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
