{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Per person, the Northern Territory has the most clubs",
    "subtitle": "Clubs per million people. Darker = more clubs for its population."
  },
  "width": 620,
  "height": 490,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27
    ],
    "scale": 760,
    "translate": [
      305,
      248
    ]
  },
  "data": {
    "url": "data/astronomy_clubs.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Clubs"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/state_population.csv"
        },
        "key": "State",
        "fields": [
          "Population"
        ]
      }
    },
    {
      "calculate": "datum.Clubs / datum.Population * 1000000",
      "as": "ClubsPerMillion"
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/australia_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "key": "properties.name"
      },
      "as": "geo"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "color": {
      "field": "ClubsPerMillion",
      "type": "quantitative",
      "title": "Clubs per million people",
      "scale": {
        "scheme": {
          "name": "purples",
          "extent": [
            0.15,
            1
          ]
        },
        "domain": [
          0,
          4
        ]
      },
      "legend": {
        "orient": "bottom-left",
        "direction": "horizontal",
        "gradientLength": 160,
        "values": [
          0,
          1,
          2,
          3,
          4
        ]
      }
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal"
      },
      {
        "field": "Clubs",
        "type": "quantitative",
        "title": "Clubs"
      },
      {
        "field": "Population",
        "type": "quantitative",
        "format": ",",
        "title": "People"
      },
      {
        "field": "ClubsPerMillion",
        "type": "quantitative",
        "format": ".1f",
        "title": "Clubs per million people"
      }
    ]
  },
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
