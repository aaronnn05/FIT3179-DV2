{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "One club puts the Northern Territory on top per million people",
    "subtitle": "Clubs for every million residents. Darker = more clubs."
  },
  "width": 700,
  "height": 560,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27
    ],
    "scale": 840,
    "translate": [
      326,
      276
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/astronomy_clubs.csv"
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Clubs"
            }
          ],
          "groupby": [
            "State"
          ]
        },
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "data/state_population.csv"
            },
            "key": "State",
            "fields": [
              "Population"
            ]
          }
        },
        {
          "calculate": "datum.Clubs / datum.Population * 1000000",
          "as": "ClubsPerMillion"
        },
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "ClubsPerMillion",
          "type": "quantitative",
          "title": "Clubs per million people",
          "scale": {
            "scheme": {
              "name": "purples",
              "extent": [
                0.15,
                1
              ]
            },
            "domain": [
              0,
              4
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 200,
            "values": [
              0,
              1,
              2,
              3,
              4
            ]
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Clubs",
            "type": "quantitative",
            "title": "Clubs"
          },
          {
            "field": "Population",
            "type": "quantitative",
            "format": ",",
            "title": "People"
          },
          {
            "field": "ClubsPerMillion",
            "type": "quantitative",
            "format": ".1f",
            "title": "Clubs per million people"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 132.5,
            "lat": -17.5,
            "lx": 124.5,
            "ly": -11.2,
            "text": "Northern Territory: 1 club\nfor about 269,000 people",
            "align": "right",
            "dx": -8
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#14213d",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lx"
        },
        "latitude2": {
          "field": "ly"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 132.5,
            "lat": -17.5,
            "lx": 124.5,
            "ly": -11.2,
            "text": "Northern Territory: 1 club\nfor about 269,000 people",
            "align": "right",
            "dx": -8
          }
        ]
      },
      "mark": {
        "type": "circle",
        "color": "#14213d",
        "size": 22
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 132.5,
            "lat": -17.5,
            "lx": 124.5,
            "ly": -11.2,
            "text": "Northern Territory: 1 club\nfor about 269,000 people",
            "align": "right",
            "dx": -8
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#14213d",
        "lineBreak": "\n",
        "lineHeight": 16,
        "dx": -8
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 14,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
