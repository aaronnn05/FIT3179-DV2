{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Truly dark skies are rare",
    "subtitle": "Reports for each sky darkness score, 2017 to 2025. Only 184 of 6,432 scored 7."
  },
  "width": 560,
  "height": 250,
  "data": {
    "url": "data/globe_at_night_australia.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 56,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "SkyDarkness",
          "type": "ordinal",
          "title": "Sky darkness (1 = bright city sky, 7 = Milky Way clearly visible)",
          "axis": {
            "labelAngle": 0,
            "ticks": false,
            "labelFontSize": 14,
            "labelColor": "#14213d",
            "titlePadding": 10
          }
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "axis": null
        },
        "color": {
          "field": "SkyDarkness",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "scheme": {
              "name": "blues",
              "extent": [
                0.25,
                1
              ]
            },
            "domain": [
              1,
              7
            ]
          }
        },
        "tooltip": [
          {
            "field": "SkyDarkness",
            "type": "ordinal",
            "title": "Score"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Reports",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 13
      },
      "encoding": {
        "x": {
          "field": "SkyDarkness",
          "type": "ordinal"
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative"
        },
        "text": {
          "aggregate": "count",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
