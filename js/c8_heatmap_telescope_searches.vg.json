{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Telescope searches barely change, with one exception",
    "subtitle": [
      "Monthly Google searches for \"telescope\" in Australia. Darker = more searches.",
      "Colours stop at 30 so small changes show; July 2022 reached 100."
    ]
  },
  "width": 440,
  "height": 300,
  "data": {
    "url": "data/telescope_searches_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Month": "date"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f7f8fa",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "format": "%b",
            "orient": "top",
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "Month",
          "timeUnit": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "Interest",
          "type": "quantitative",
          "title": "Searches (100 = busiest month)",
          "scale": {
            "scheme": {
              "name": "oranges",
              "extent": [
                0.05,
                1
              ]
            },
            "domain": [
              0,
              30
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "values": [
              0,
              10,
              20,
              30
            ]
          }
        },
        "tooltip": [
          {
            "field": "Month",
            "type": "temporal",
            "format": "%B %Y",
            "title": "Month"
          },
          {
            "field": "Interest",
            "type": "quantitative",
            "title": "Searches (100 = busiest month)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "year(datum.Month) == 2022 && month(datum.Month) == 6"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#14213d",
        "strokeWidth": 2.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal"
        },
        "y": {
          "field": "Month",
          "timeUnit": "year",
          "type": "ordinal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Month": "2022-12-01",
            "Row": "2022-07-01",
            "text": "July 2022: the James Webb\nSpace Telescope shared\nits first pictures"
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Month": "date",
            "Row": "date"
          }
        }
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 26,
        "lineBreak": "\n",
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal"
        },
        "y": {
          "field": "Row",
          "timeUnit": "year",
          "type": "ordinal"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 150,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
