{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Telescope searches rise only with big sky news",
    "subtitle": [
      "Monthly Google searches for \"telescope\" in Australia. Darker = more searches.",
      "Every month above 30 gets the darkest colour, so small changes stay visible."
    ]
  },
  "width": 400,
  "height": 340,
  "data": {
    "url": "data/telescope_searches_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Month": "date"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#e9edf7",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "format": "%b",
            "orient": "top",
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "Month",
          "timeUnit": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "Interest",
          "type": "quantitative",
          "title": "Searches (100 = busiest month)",
          "scale": {
            "scheme": {
              "name": "oranges",
              "extent": [
                0.05,
                1
              ]
            },
            "domain": [
              0,
              30
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 240,
            "titleLimit": 400,
            "values": [
              0,
              15,
              30
            ],
            "labelExpr": "datum.value == 30 ? '30 or more' : datum.value"
          }
        },
        "tooltip": [
          {
            "field": "Month",
            "type": "temporal",
            "format": "%B %Y",
            "title": "Month"
          },
          {
            "field": "Interest",
            "type": "quantitative",
            "title": "Searches (100 = busiest month)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "(year(datum.Month) == 2022 && month(datum.Month) == 6) || (year(datum.Month) == 2021 && month(datum.Month) == 11) || (year(datum.Month) == 2020 && month(datum.Month) == 11) || (year(datum.Month) == 2022 && month(datum.Month) == 0)"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#14213d",
        "strokeWidth": 2.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal"
        },
        "y": {
          "field": "Month",
          "timeUnit": "year",
          "type": "ordinal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Month": "2022-12-01",
            "Row": "2020-07-01",
            "text": "December 2020: Jupiter meets Saturn"
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Month": "date",
            "Row": "date"
          }
        }
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 26
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal"
        },
        "y": {
          "field": "Row",
          "timeUnit": "year",
          "type": "ordinal"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Month": "2022-12-01",
            "Row": "2021-07-01",
            "text": "December 2021: the Webb Space\nTelescope launches (January too)"
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Month": "date",
            "Row": "date"
          }
        }
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 26,
        "dy": -10,
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal"
        },
        "y": {
          "field": "Row",
          "timeUnit": "year",
          "type": "ordinal"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Row": "2022-07-01"
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Row": "date"
          }
        }
      },
      "mark": {
        "type": "rule",
        "color": "#14213d",
        "strokeWidth": 1,
        "x": {
          "expr": "width * 7 / 12 + 1"
        },
        "x2": {
          "expr": "width + 5"
        }
      },
      "encoding": {
        "y": {
          "field": "Row",
          "timeUnit": "year",
          "type": "ordinal",
          "bandPosition": 0.5
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Month": "2022-12-01",
            "Row": "2022-07-01",
            "text": "July 2022: Webb's first pictures"
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Month": "date",
            "Row": "date"
          }
        }
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 26,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "Month",
          "timeUnit": "month",
          "type": "ordinal"
        },
        "y": {
          "field": "Row",
          "timeUnit": "year",
          "type": "ordinal"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 120,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 14,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
