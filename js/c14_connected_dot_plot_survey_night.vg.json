{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most states reported far more on the survey night",
    "subtitle": [
      "Sky reports for every million residents, 21 June 2020 compared with all other nights."
    ]
  },
  "width": 560,
  "height": 330,
  "data": {
    "url": "data/globe_at_night_australia.csv"
  },
  "transform": [
    {
      "calculate": "datum.Date == '2020-06-21' ? 'Survey night, 21 June 2020' : 'All other nights'",
      "as": "Night"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Reports"
        }
      ],
      "groupby": [
        "State",
        "Night"
      ]
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/state_population.csv"
        },
        "key": "State",
        "fields": [
          "Population"
        ]
      }
    },
    {
      "calculate": "datum.Reports / datum.Population * 1000000",
      "as": "PerMillion"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "PerMillion",
          "as": "Top"
        },
        {
          "op": "min",
          "field": "PerMillion",
          "as": "Low"
        }
      ],
      "groupby": [
        "State"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {
        "op": "max",
        "field": "PerMillion",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 230,
        "ticks": false,
        "domain": false,
        "labelPadding": 8,
        "labelFontSize": 14,
        "labelColor": "#14213d"
      }
    },
    "x": {
      "field": "PerMillion",
      "type": "quantitative",
      "title": "Reports per million residents",
      "scale": {
        "domain": [
          0,
          500
        ]
      },
      "axis": {
        "values": [
          0,
          100,
          200,
          300,
          400,
          500
        ],
        "grid": true,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#9fb0bd"
      },
      "encoding": {
        "x": {
          "field": "Top",
          "type": "quantitative"
        },
        "x2": {
          "field": "PerMillion",
          "aggregate": "min"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "Night",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "All other nights",
              "Survey night, 21 June 2020"
            ],
            "range": [
              "#c98f2a",
              "#1f6f7a"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolSize": 170,
            "labelFontSize": 14
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Night",
            "type": "nominal",
            "title": "When"
          },
          {
            "field": "Reports",
            "type": "quantitative",
            "title": "Reports"
          },
          {
            "field": "PerMillion",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Reports per million residents"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Top == datum.Low && datum.Night == 'All other nights'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "color": "#364152"
      },
      "encoding": {
        "x": {
          "field": "PerMillion",
          "type": "quantitative"
        },
        "text": {
          "value": "same on both"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "State": "Australian Capital Territory",
            "x": 464,
            "text": "464 on the survey night,\n74 on all other nights"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dy": 12,
        "lineBreak": "\n",
        "lineHeight": 16,
        "color": "#14213d"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "State",
          "type": "nominal"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 23,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 17,
      "subtitleColor": "#364152",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#364152",
      "domainColor": "#a9b2c6",
      "tickColor": "#a9b2c6",
      "gridColor": "#d3d9e8"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": "normal",
      "labelColor": "#364152",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 15,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
