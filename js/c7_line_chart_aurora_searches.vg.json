{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Aurora searches jump when a big solar storm hits",
    "subtitle": "Weekly Google searches for \"aurora\" in Australia (100 = busiest week)."
  },
  "width": 640,
  "height": 260,
  "data": {
    "url": "data/aurora_searches_weekly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Week": "date"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#c2410c",
        "opacity": 0.12
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#c2410c",
        "strokeWidth": 1.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Week",
            "type": "temporal",
            "title": "Week starting",
            "format": "%e %B %Y"
          },
          {
            "field": "Interest",
            "type": "quantitative",
            "title": "Searches (100 = busiest)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Week": "2024-05-12",
            "Interest": 100,
            "text": "May 2024: the strongest solar\nstorm in more than 20 years"
          },
          {
            "Week": "2024-10-06",
            "Interest": 38,
            "text": "October 2024:\nanother strong storm"
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Week": "date"
          }
        }
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 6,
        "lineBreak": "\n",
        "lineHeight": 16
      },
      "encoding": {
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Week": "2024-05-12",
            "Interest": 100
          },
          {
            "Week": "2024-10-06",
            "Interest": 38
          }
        ],
        "format": {
          "type": "json",
          "parse": {
            "Week": "date"
          }
        }
      },
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#14213d",
        "size": 40
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "Week",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "tickCount": "year",
        "grid": false
      }
    },
    "y": {
      "field": "Interest",
      "type": "quantitative",
      "title": "Searches (100 = busiest week)",
      "scale": {
        "domain": [
          0,
          105
        ]
      },
      "axis": {
        "values": [
          0,
          25,
          50,
          75,
          100
        ]
      }
    }
  },
  "padding": {
    "left": 0,
    "top": 2,
    "right": 8,
    "bottom": 4
  },
  "background": "transparent",
  "config": {
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Serif 4', Georgia, serif",
      "fontSize": 21,
      "fontWeight": 600,
      "color": "#14213d",
      "anchor": "start",
      "frame": "bounds",
      "offset": 14,
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 15,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 6,
      "lineHeight": 26,
      "subtitleLineHeight": 19
    },
    "axis": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domainColor": "#b8c0cc",
      "tickColor": "#b8c0cc",
      "gridColor": "#e3e7ee"
    },
    "legend": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#4a5568",
      "titleColor": "#14213d"
    },
    "text": {
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 13,
      "color": "#14213d"
    },
    "header": {
      "labelFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "titleFont": "'Source Serif 4', Georgia, serif"
    }
  }
}
